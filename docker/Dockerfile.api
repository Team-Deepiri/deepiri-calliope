# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Optional Aamati extras (mood mappings, ONNX stack). The app degrades
# gracefully without it (aamati_prior checks every path), so the clone must
# never break the build — the repo may be private or unreachable.
RUN git clone --depth 1 https://github.com/jrb00013/Aamati.git /opt/Aamati || \
    echo "WARN: Aamati clone skipped — running on built-in fallbacks"

COPY backend/pyproject.toml backend/poetry.lock /app/
COPY backend/src /app/src

RUN pip install --no-cache-dir "setuptools<81" wheel poetry==2.2.1 \
    && pip install --no-cache-dir --no-build-isolation crepe==0.0.16 \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --only main --no-root

ENV PYTHONPATH=/app/src:/opt/Aamati
EXPOSE 8080

CMD ["uvicorn", "calliope.main:app", "--host", "0.0.0.0", "--port", "8080"]
